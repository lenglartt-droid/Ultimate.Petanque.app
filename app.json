{
  "expo": {
    "name": "Ultimate Petanque",
    "slug": "ppss-petanque-scorer",
    "version": "1.15.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-ultimate-petanque.png",
    "scheme": "ultimatepetanque",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ultimatepetanque.app",
      "associatedDomains": [
        "applinks:ultimatepetanque.app"
      ],
      "config": {
        "googleMapsApiKey": "AIzaSyCN7isQnQhdYy7Rep2mDmwu931KZyGkMck"
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Ultimate Petanque utilise la caméra pour prendre des photos de profil, de boules et de terrains.",
        "NSPhotoLibraryUsageDescription": "Ultimate Petanque accède à vos photos pour ajouter des images de profil, de boules et de terrains.",
        "NSLocationWhenInUseUsageDescription": "Ultimate Petanque utilise votre position pour afficher les terrains et joueurs à proximité sur la carte.",
        "NSUserTrackingUsageDescription": "Ultimate Petanque utilise cet identifiant pour vous proposer des publicités pertinentes et améliorer votre expérience.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-ultimate-petanque.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAGXmO6mX-9GrCvg_z4ZxXK4siw_Q7lbFo"
        }
      },
      "edgeToEdgeEnabled": false,
      "package": "com.ultimatepetanque.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "ultimatepetanque",
              "host": "*",
              "pathPrefix": "/share"
            },
            {
              "scheme": "ultimatepetanque",
              "host": "*",
              "pathPrefix": "/meetup"
            },
            {
              "scheme": "https",
              "host": "ultimatepetanque.app",
              "pathPrefix": "/share"
            },
            {
              "scheme": "https",
              "host": "ultimatepetanque.app",
              "pathPrefix": "/meetup"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo-ultimate-petanque.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-ultimate-petanque.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo-ultimate-petanque.png",
          "color": "#2563EB",
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ultimate Petanque utilise la caméra pour scanner les QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "80801df7-6ed9-4bb4-bc6b-a66f77a24796"
      }
    }
  }
}
