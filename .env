EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyAGXmO6mX-9GrCvg_z4ZxXK4siw_Q7lbFo

# Dev only: allow multiple signups on same device/emulator (ignored in production builds without this flag)
EXPO_PUBLIC_SKIP_DEVICE_ACCOUNT_LIMIT=true

# Must match Supabase → Auth → Providers → Email → OTP length (your project sends 6).
EXPO_PUBLIC_AUTH_OTP_LENGTH=6

# Supabase Auth (Dashboard): Magic Link email template must use {{ .Token }} — see supabase/email-templates/magic-link-otp.html
# URL configuration: Site URL onspaceapp://auth; redirect allow list onspaceapp://auth
# Google sign-in label (xzkdtudhtprpuzlamjdt.supabase.co → "Ultimate Petanque"): NOT fixable in app code — see supabase/google-oauth-branding-setup.md