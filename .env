# Supabase / OnSpace: URL and anon key MUST be from the SAME project.
# For *.supabase.co, the subdomain MUST match the JWT "ref" inside the anon key (decode middle segment at jwt.io).
# Wrong pairing → login shows "Invalid API key".

# OnSpace (legacy) — uncomment BOTH lines if you use this backend:
# EXPO_PUBLIC_SUPABASE_URL=https://sxjwuzpykeymicumsxjw.backend.onspace.ai
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyZWYiOiJzeGp3dXpweWtleW1pY3Vtc3hqdyIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNzcwMzM4Mzg5LCJleHAiOjIwODU2OTgzODksImlzcyI6Im9uc3BhY2UifQ.DGupsMslycu4ADNGG8IWY5hUz-bvOjdfINPBatgvQKs

