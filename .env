EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh6a2R0dWRodHBycHV6bGFtamR0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzU0MDM0OTcsImV4cCI6MjA5MDk3OTQ5N30.Mbc3dw_d6DaiywwOG4UO3MBq9YY_x1bZdH5cLQTAipM
